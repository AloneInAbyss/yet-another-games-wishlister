# Banco: arquivo SQLite local; em produção, a URL libsql:// e o token do Turso
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Login com Google (opcional; sem isso só aparece o login com a Steam)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Protege o endpoint do cron (/api/cron/refresh)
CRON_SECRET=
# Só em desenvolvimento: libera /api/auth/dev para testes automatizados
# ALLOW_DEV_LOGIN=1
